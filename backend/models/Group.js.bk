const mongoose = require('mongoose');

const groupSchema = new mongoose.Schema({
  betType: {
    type: String,
    enum: ['First Better', 'Bidding Method', 'Multi Betters'],
    default: 'First Better',
    required: true,
  },
  betAmount: {
    type: Number,
    required: true,
  },
  minimumIncrement: {
    type: Number,
    required: function () {
      return this.betType === 'Bidding Method';
    },
  },
  match: {
    type: mongoose.Schema.Types.ObjectId,
    ref: 'Match',
    required: true,
  },
  status: {
    type: String,
    enum: ['Active', 'Inactive'],
    default: 'Inactive',
  },
  totalBetAmount: {
    type: Number,
    default: 0,
  },
  winnerShare1: {
    type: Number,
    required: true,
  },
  winnerShare2: {
    type: Number,
    required: true,
  },
  winnerShare3: {
    type: Number,
    required: true,
  },
  adminShare: {
    type: Number,
    required: true,
  },
  managerShare: {
    type: Number,
    required: true,
  },
  createdAt: {
    type: Date,
    default: Date.now,
  },
});

// Before saving, auto-fill adminShare & managerShare from the club
groupSchema.pre('save', async function (next) {
  const Match = mongoose.model('Match');
  const Club = mongoose.model('Club');

  const match = await Match.findById(this.match).populate('club');
  if (match && match.club) {
    const club = await Club.findById(match.club);
    this.adminShare = club.adminShare;
    this.managerShare = club.managerShare;
  }

  next();
});

module.exports = mongoose.model('Group', groupSchema);
