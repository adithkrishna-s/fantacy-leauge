# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- Database (Postgres) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fantasyleague

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret

# --- Server ---
PORT=5001
NODE_ENV=development

# --- CORS ---
# Optional. Comma-separated extra browser origins allowed to call the API,
# in addition to the built-in production/localhost defaults.
# CORS_ORIGINS=https://staging.example.com,http://localhost:5173

# --- Redis (WhatsApp queue) ---
# The queue currently connects to localhost:6379 by default.

# --- WhatsApp sender API ---
# Required for outbound WhatsApp notifications. Rotate these if they were
# ever committed to source control.
WHATSAPP_APPKEY=
WHATSAPP_AUTHKEY=
# Optional override; defaults to the current provider endpoint.
# WHATSAPP_API_URL=https://websender.eappcloud.in/api/create-message
